{
  "name": "glovax-technologies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:turso": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx seed.ts",
    "db:seed:turso": "dotenv -e .env.local -- tsx seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:prepare": "cross-env DATABASE_URL=file:./e2e.db DATABASE_AUTH_TOKEN= drizzle-kit push --force && cross-env DATABASE_URL=file:./e2e.db DATABASE_AUTH_TOKEN= ALLOW_SEED=true tsx seed.ts && cross-env DATABASE_URL=file:./e2e.db DATABASE_AUTH_TOKEN= next build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@libsql/client": "^0.17.4",
    "@sentry/nextjs": "11.11.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "lucide-react": "^0.574.0",
    "next": "16.4.5",
    "radix-ui": "^1.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.78.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.23.0",
    "svgo": "^4.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
